# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_key_here

# Groq API Key (get from https://console.groq.com/keys)
# Safety net: when every free OpenRouter model is rate-limited, llm_service
# falls back to Groq. Without this key that fallback cannot fire and users
# get the "daily free-tier limit" message instead.
GROQ_API_KEY=your_groq_key_here

# AWS credentials are NOT read from this file — boto3 uses the standard chain
# (`aws configure`, env vars, or an instance role). Deploy scripts push the
# keys above to the Lambda as environment variables.
AWS_REGION=us-east-1

# DynamoDB (leave blank for AWS cloud, set for local DynamoDB)
DYNAMODB_ENDPOINT_URL=http://localhost:8000
